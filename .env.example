# =============================================================================
# 公开发布配置（推荐）
# 在服务器 .env 中设置 DEMO_API_KEY，供访客免费试用；切勿将真实 Key 提交到 Git
# =============================================================================
DEMO_API_KEY=
DEMO_BASE_URL=https://api.deepseek.com/v1
DEMO_MODEL=deepseek-chat
DEMO_DAILY_LIMIT=10
DEMO_PER_MINUTE_LIMIT=2
DEMO_MAX_CHARS=500
DEMO_DELAY_SECONDS=0.5

# 禁止访客通过网页修改服务端 .env 中的 Key（用户 Key 保存在浏览器本地）
ALLOW_ENV_KEY_WRITE=false
USE_SERVER_API_KEY=false

# =============================================================================
# 本地自托管（可选，默认关闭）
# 仅当 USE_SERVER_API_KEY=true 时，OPENAI_API_KEY 才会对所有访客生效
# =============================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 本地 Ollama（可选）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# 嵌入后端：keyword（1GB 演示）| fastembed（语义更好，约 1.5GB）| flag（本地高配）
EMBEDDING_BACKEND=keyword
# keyword 模式专用相关度阈值（分数为关键词重合度 0~1，默认已调低）
# KEYWORD_MIN_RELEVANCE_SCORE=0.15
# DEMO_KEYWORD_MIN_RELEVANCE_SCORE=0.10
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# 分块策略（改动后需删除 data/ 重建向量）
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
MIN_SECTION_SIZE=400

# 上传入库时是否调用 LLM 生成片段摘要
INGEST_ENABLE_SUMMARY=true
# 跳过启动时导入示例文档
SKIP_DEMO_SEED=false
